# curl -Lo ./mmdebstrap-master.tar.gz https://salsa.debian.org/debian/mmdebstrap/-/archive/master/mmdebstrap-master.tar.gz
# curl -Lo ./kali-archive-keyring.gpg https://archive.kali.org/archive-keyring.gpg
